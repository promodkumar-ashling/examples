{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build project",
      "type": "shell",
      "command": "bash build.sh ${input:project}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
    },
    {
      "label": "Connect VPN",
      "type": "shell",
      "command": "bash .devcontainer/vpn.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "project",
      "type": "pickString",
      "description": "Which example to build?",
      "options": [
        { "label": "sum", "value": "sum" },
        { "label": "picojpeg", "value": "riscv-picojpeg-cmake" }
      ],
      "default": "sum"
    }
  ]
}
